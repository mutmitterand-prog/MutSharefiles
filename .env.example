# Port TCP du serveur. Laissez cette variable commentée pour laisser le système
# attribuer automatiquement un port libre à chaque démarrage.
# TRANSFERT_PORT=49152
# En développement Vite uniquement : adresse du serveur local si vous utilisez le proxy.
# VITE_API_PROXY_TARGET=http://127.0.0.1:PORT_REEL
# Dossier de stockage des données locales (appareils jumelés, historique, réglages).
TRANSFERT_DATA_DIR=
